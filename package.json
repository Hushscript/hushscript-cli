{
  "name": "@hushscript/cli",
  "version": "1.0.1",
  "description": "Command line client for the Hushscript transcription API.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Hushscript/hushscript-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hushscript/hushscript-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Hushscript/hushscript-cli/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "hushscript": "dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "config": {
    "conformanceRef": "v1.0.0"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@hushscript/sdk": "^1.1.1",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-regexp": "3.3.3",
    "globals": "17.14.0",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch@^10": "11.0.5"
  }
}
