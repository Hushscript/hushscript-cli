  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "config": {
    "conformanceRef": "v0.1.0"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@hushscript/sdk": "^0.1.0",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-regexp": "3.3.1",
    "globals": "17.13.0",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
